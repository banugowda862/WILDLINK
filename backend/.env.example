# WILDLINK Backend Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ENVIRONMENT=development
DEMO_MODE=true

# Device Authentication
DEVICE_DEFAULT_SECRET=wildlink-secure-token-default

# Optional Firebase Admin SDK Integration (When credentials available)
# FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
# FIREBASE_STORAGE_BUCKET=wildlink-app.appspot.com
# FCM_SERVER_KEY=your-firebase-cloud-messaging-key
